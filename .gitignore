# Sequencing reads and bulky intermediates
/fq_raw/
/trimmomatic/copied_reads/
/trimmomatic/trimmed_reads/
/trimmomatic/unpaired_reads/
/*.fastq
/*.fastq.gz
/*.fq
/*.fq.gz

# Generated QC outputs and extracted archives
/fastqc/
/fastqc_extracted/
/multiqc_out/
/trimmomatic/fastqc_trimmed/
/trimmomatic/fastqc_trimmed_extracted/

# Generated review metrics and runtime logs, but keep curated Markdown reports
/fastqc_review/logs/
/fastqc_review/*.tsv
/fastqc_review/*.out
/fastqc_review/*.err
!/fastqc_review/*.md
/trimmomatic/fastqc_trimmed_review/logs/
/trimmomatic/fastqc_trimmed_review/*.tsv
!/trimmomatic/fastqc_trimmed_review/*.md

# Pipeline-generated manifests and step logs
/trimmomatic/metrics/trimmomatic_input_manifest.tsv
/trimmomatic/logs/
/fastqc/logs/
/alignment/bam/
/alignment/logs/
/alignment/metrics/*.flagstat.txt
/alignment/metrics/*.idxstats.txt
!/alignment/metrics/alignment_summary.tsv
/multi_reference_alignment/bam/
/multi_reference_alignment/logs/
/multi_reference_alignment/metrics/*.flagstat.txt
/multi_reference_alignment/metrics/*.idxstats.txt
!/multi_reference_alignment/metrics/multi_reference_alignment_summary.tsv
!/multi_reference_alignment/metrics/multi_reference_alignment_mapped_pct_matrix.tsv
/kraken2_db/db/
/kraken2_db/logs/
/kraken2_classification/outputs/
/kraken2_classification/reports/
/kraken2_classification/logs/
!/kraken2_classification/metrics/kraken2_classification_summary.tsv
/kraken2_db/metadata/
/kraken2.sif
/containers/*.sif
*.log
*.out
*.err
/slurm-*.out
/slurm-*.err
*.k2d


# Local reference files and indexes
/reference/

# Python and notebook artifacts
__pycache__/
*.py[cod]
.ipynb_checkpoints/

# Temporary files and caches
*.tmp
*.temp
*.swp
*~
.cache/

# Local secrets
.env
.env.*
!.env.example
.emv
*.pem
*.key

# OS junk
.DS_Store
Thumbs.db
